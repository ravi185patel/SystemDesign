    {
      "id": "3GLOA2FLb4EKgI9P3AEeY",
      "type": "text",
      "x": 1017.515969049361,
      "y": 8527.266139499727,
      "width": 1000.6593017578125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7M",
      "roundness": null,
      "seed": 402124022,
      "version": 572,
      "versionNonce": 668142326,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782922164467,
      "link": null,
      "locked": false,
      "text": "1) search flow :  Search service which search in elastic search and return result to user.\n2) Booking flow: after getting train info with available seat, user pass selection of seat with train id.\n3) Payment flow: after successful booked/locked seat, user redirect to payment. \nsuccess= set Booked status in db | failed = revert back seat status to open  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) search flow :  Search service which search in elastic search and return result to user.\n2) Booking flow: after getting train info with available seat, user pass selection of seat with train id.\n3) Payment flow: after successful booked/locked seat, user redirect to payment. \nsuccess= set Booked status in db | failed = revert back seat status to open  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MJLADRl9lct5AVZA5fYyZ",
      "type": "text",
      "x": 989.1826357160277,
      "y": 8948.932806166393,
      "width": 258.4598083496094,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7O",
      "roundness": null,
      "seed": 224363882,
      "version": 205,
      "versionNonce": 1381757110,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782922112188,
      "link": null,
      "locked": false,
      "text": "What achieved\n1) Scalable (service)\n2) handle 1M user\n3) search latency improved\n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What achieved\n1) Scalable (service)\n2) handle 1M user\n3) search latency improved\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b3rQFuNRWyyk21mUwecgP",
      "type": "text",
      "x": 1945.293780735559,
      "y": 9018.932806166393,
      "width": 585.1795654296875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7P",
      "roundness": null,
      "seed": 1250113974,
      "version": 357,
      "versionNonce": 800251894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782922170134,
      "link": null,
      "locked": false,
      "text": "Issue\n1) DB load increase as locking implement in DB.\n2) Latency increase as each user has to wait even he is try\nto book ticket in another train.\n  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Issue\n1) DB load increase as locking implement in DB.\n2) Latency increase as each user has to wait even he is try\nto book ticket in another train.\n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
