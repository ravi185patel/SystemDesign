    {
      "id": "Q8vbXznu7QEoqsno6Lgsi",
      "type": "text",
      "x": 1129.7380302065878,
      "y": 7225.599421970429,
      "width": 900.999267578125,
      "height": 1075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6g",
      "roundness": null,
      "seed": 246052918,
      "version": 988,
      "versionNonce": 1925127658,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782921360647,
      "link": null,
      "locked": false,
      "text": "End Points\n1) train/search?name={name}&&soruce={source}}&&dest={dest}}&&from={from}}&&to={to}\n{\n    status:\"\"\n    data :[\n        {\n            name:\"\",from:\"\",to:\"',seatsAvaiabale:count,totalSeats:count,reservedSeat:count\n        }\n    ]\n}\n1) train/{trainId}/book\ninput json:\n{\n    status:\"\"\n    data :[\n        {\n            trainId:'',\n            passangers:[\n                  {\n                     passangerName: | passangerDob: | passangerVerificationDoc: ...\n                  }  \n            ]\n        }\n    ]\n}\noutput json:\n{\n    status:''\n    data:[ PNR ...]\n    \n    \n}\n2) train/{bookingId}/payment\n\n\nEntities\nTrain ( name, src,dest,time..)\nCoach(coachName, train)\nSeat (seatNo, typeOfSeat,coach)\nPassanger (passName, etc)\nTicket (ticketId,passId,seatId, steatStaus) \nPayment (ticketid, payment)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "End Points\n1) train/search?name={name}&&soruce={source}}&&dest={dest}}&&from={from}}&&to={to}\n{\n    status:\"\"\n    data :[\n        {\n            name:\"\",from:\"\",to:\"',seatsAvaiabale:count,totalSeats:count,reservedSeat:count\n        }\n    ]\n}\n1) train/{trainId}/book\ninput json:\n{\n    status:\"\"\n    data :[\n        {\n            trainId:'',\n            passangers:[\n                  {\n                     passangerName: | passangerDob: | passangerVerificationDoc: ...\n                  }  \n            ]\n        }\n    ]\n}\noutput json:\n{\n    status:''\n    data:[ PNR ...]\n    \n    \n}\n2) train/{bookingId}/payment\n\n\nEntities\nTrain ( name, src,dest,time..)\nCoach(coachName, train)\nSeat (seatNo, typeOfSeat,coach)\nPassanger (passName, etc)\nTicket (ticketId,passId,seatId, steatStaus) \nPayment (ticketid, payment)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
