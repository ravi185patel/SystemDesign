    {
      "id": "dvBmlKiE3VkxH2djpwI2M",
      "type": "text",
      "x": 985.7381827944781,
      "y": 9821.71056698995,
      "width": 1163.3792724609375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
