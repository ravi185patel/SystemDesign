      "versionNonce": 341038602,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777816878453,
      "link": null,
      "locked": false,
      "text": "Achieved\n1) read and redirection\ncan be faster \n2) WriteThroughCache\n3) low latency \nas reading service is spearated\n4) no Single point of failure\n (Avaialability)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Achieved\n1) read and redirection\ncan be faster \n2) WriteThroughCache\n3) low latency \nas reading service is spearated\n4) no Single point of failure\n (Avaialability)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uhROW-bWS2371BMwjKDKV",
      "type": "text",
      "x": 851.5555555555557,
