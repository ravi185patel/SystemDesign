      "isDeleted": false,
      "boundElements": [],
      "updated": 1777815730698,
      "link": null,
      "locked": false,
      "text": "Requirement\nFunctional\n1) convert original into tiny url\n2) redirect to original url\n\nNon-functional\n1) low latency redirection\n2) unique url\n3) availability >> consistency\n4) scalable 1B urls and 100DAU\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirement\nFunctional\n1) convert original into tiny url\n2) redirect to original url\n\nNon-functional\n1) low latency redirection\n2) unique url\n3) availability >> consistency\n4) scalable 1B urls and 100DAU\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l8ehRmkVBiUL_0H_RdCqp",
      "type": "text",
      "x": 550.1269695948041,
      "y": 76.42062038845484,
      "width": 232.93984985351562,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
