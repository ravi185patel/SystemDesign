      "isDeleted": false,
      "boundElements": [],
      "updated": 1777825709065,
      "link": null,
      "locked": false,
      "text": "Entities\n1) TinyUrl\n -> original URL\n -> tiny Url\n -> expiryTime\n -> createdBy\n\n2) OriginalUrl\n -> originalUrl\n -> createdBy\n -> expiryTime(optional)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n1) TinyUrl\n -> original URL\n -> tiny Url\n -> expiryTime\n -> createdBy\n\n2) OriginalUrl\n -> originalUrl\n -> createdBy\n -> expiryTime(optional)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_IaThT-niNciY4qrQzzRp",
      "type": "text",
