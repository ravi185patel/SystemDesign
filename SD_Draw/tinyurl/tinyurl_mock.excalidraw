      "isDeleted": false,
      "boundElements": [],
      "updated": 1777815907239,
      "link": null,
      "locked": false,
      "text": "RestEndpoints\n1) Post\n/tinyUrl/\n{\n \"originalUrl\":\n \"createdBy\":\n}\n\n2) Get\n/tinyUrl/{url}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RestEndpoints\n1) Post\n/tinyUrl/\n{\n \"originalUrl\":\n \"createdBy\":\n}\n\n2) Get\n/tinyUrl/{url}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
