    {
      "id": "uBUz_P39oHRYamxOejgIR",
      "type": "text",
      "x": 621.9814376831057,
      "y": 1413.722193400065,
      "width": 775.3795166015625,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 1622136164,
      "version": 849,
      "versionNonce": 784125412,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777219780876,
      "link": null,
      "locked": false,
      "text": "Problem and their solution\n1) gloal counter -> attacker can predicat URL due to counter\n -> use Base62 and use secrete key for the same\n\n2) steal data in cache\n-> Croan JOB :- to remove and update entries from db to cache\nat reagular enterval\n-> Set expireation time:- when try to access url extend it and upadte url in db \n\n3) retries for both catch and db\n-> use fixed retires for cache if cache is down \n-> use fixed retires for db as well.\n\n4) for consistency maintain in both db and redis\n-> use redis with command atomic \n-> use db with constraint on URL\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem and their solution\n1) gloal counter -> attacker can predicat URL due to counter\n -> use Base62 and use secrete key for the same\n\n2) steal data in cache\n-> Croan JOB :- to remove and update entries from db to cache\nat reagular enterval\n-> Set expireation time:- when try to access url extend it and upadte url in db \n\n3) retries for both catch and db\n-> use fixed retires for cache if cache is down \n-> use fixed retires for db as well.\n\n4) for consistency maintain in both db and redis\n-> use redis with command atomic \n-> use db with constraint on URL\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
