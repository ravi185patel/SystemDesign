    {
      "id": "2zIFOMBWq4Yr192XCreMj",
      "type": "text",
      "x": 895.4762704031816,
      "y": 1044.5715157645107,
      "width": 1060.499267578125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3t",
      "roundness": null,
      "seed": 1722341383,
      "version": 780,
      "versionNonce": 461214441,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779033788632,
      "link": null,
      "locked": false,
      "text": "Web socket: which is bidirectional, and it will persist connection.\nDue to its bidirectional nature, it is used for read time message. \n\nHere we can use publish module ( redis pub/sub or kafka)\nWe can't use redis pub sub as it won't persist message it just for notification, where as kafka store it and \ngives us better failure handling.\nKafka: We used Kafka for message for delivery.\nHow: first after save message into DB we push that message into kafka.\nFlow user -> websocket -> msg service -> oracle -> msgservice -> kafka -> websocket -> users.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Web socket: which is bidirectional, and it will persist connection.\nDue to its bidirectional nature, it is used for read time message. \n\nHere we can use publish module ( redis pub/sub or kafka)\nWe can't use redis pub sub as it won't persist message it just for notification, where as kafka store it and \ngives us better failure handling.\nKafka: We used Kafka for message for delivery.\nHow: first after save message into DB we push that message into kafka.\nFlow user -> websocket -> msg service -> oracle -> msgservice -> kafka -> websocket -> users.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
