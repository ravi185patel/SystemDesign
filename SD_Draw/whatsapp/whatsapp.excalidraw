    {
      "id": "lz4ZURKapBtx2CoA7C-Nq",
      "type": "text",
      "x": 857.4762704031816,
      "y": -509.42848423548935,
      "width": 400.0997619628906,
      "height": 325,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
