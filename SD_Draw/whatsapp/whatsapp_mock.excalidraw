    {
      "id": "yyx2EUtDmopQ2hxTLowf0",
      "type": "text",
      "x": 897.4762704031816,
      "y": 1730.5715157645107,
      "width": 741.9594116210938,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
