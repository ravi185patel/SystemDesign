      "boundElements": null,
      "updated": 1779513024989,
      "link": null,
      "locked": false,
      "text": "Highlight points\n1) Websocket instead of rest :\nbecause rest is not provide realistic messaging.\nand every time pass message and ack it required \nmore work, process and time consuming as we have\nto open connection for each request so\nwe directly use websockets",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Highlight points\n1) Websocket instead of rest :\nbecause rest is not provide realistic messaging.\nand every time pass message and ack it required \nmore work, process and time consuming as we have\nto open connection for each request so\nwe directly use websockets",
      "autoResize": true,
      "lineHeight": 1.25
    },
