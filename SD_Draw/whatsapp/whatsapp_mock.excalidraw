      "updated": 1779512097547,
      "link": null,
      "locked": false,
      "text": "Rest End Point\ncreate user is fine\nMessage\nPost\n{\n \"sendBy\":\n \"chatGroupId\":\n \"msg\":\"content\"\n}\nReceived\nGet\n/msg/userId\n// issue to load all messages at once\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rest End Point\ncreate user is fine\nMessage\nPost\n{\n \"sendBy\":\n \"chatGroupId\":\n \"msg\":\"content\"\n}\nReceived\nGet\n/msg/userId\n// issue to load all messages at once\n\n",
