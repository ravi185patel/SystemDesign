      "index": "b4B",
      "roundness": null,
      "seed": 82928871,
      "version": 853,
      "versionNonce": 380192091,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1779512097548,
      "link": null,
      "locked": false,
      "text": "Solution of problmes.\nProblem 1 and 2: create rest endpoint which pass last message id to message service and message service provide all message after that message id.\nProblem 3: Topic based on group is not good which increase problems. so create topic based on region + id\nwhen group message saved and publish based on region + id topic and with details like groupId+senderId+timing\nbased on groupid specific consumer read (websockets)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solution of problmes.\nProblem 1 and 2: create rest endpoint which pass last message id to message service and message service provide all message after that message id.\nProblem 3: Topic based on group is not good which increase problems. so create topic based on region + id\nwhen group message saved and publish based on region + id topic and with details like groupId+senderId+timing\nbased on groupid specific consumer read (websockets)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
