      "seed": 468062493,
      "version": 221,
      "versionNonce": 1973050269,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780974462568,
      "link": null,
      "locked": false,
      "text": "Solution: Master slave DB\n-> Master used only for write \n-> Slave used only for read.\n-> when master failed it will be replaced by replica",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solution: Master slave DB\n-> Master used only for write \n-> Slave used only for read.\n-> when master failed it will be replaced by replica",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u4Rw3mEStCeyqvAncFCRe",
      "type": "text",
      "x": 1124.3213889712363,
      "y": 4699.349345676484,
      "width": 395.79974365234375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6I",
      "roundness": null,
      "seed": 1301900093,
      "version": 118,
      "versionNonce": 1020105757,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780974611916,
      "link": null,
      "locked": false,
      "text": "Read data was not frequently changeed.\nSolution: Cache\n-> write-through\n-> Write-around",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read data was not frequently changeed.\nSolution: Cache\n-> write-through\n-> Write-around",
      "autoResize": true,
      "lineHeight": 1.25
    },
