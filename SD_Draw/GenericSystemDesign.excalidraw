    {
      "id": "tXaCssRoeVCFN12wQlgu_",
      "type": "text",
      "x": 1129.3213889712363,
      "y": 4578.099345676484,
      "width": 482.81964111328125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
